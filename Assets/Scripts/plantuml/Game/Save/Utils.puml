@startuml
class SerializableVector3 {
    + x : float
    + y : float
    + z : float
    + SerializableVector3(vector3:Vector3)
    + ToVector3() : Vector3
}
class SerializableQuaternion {
    + x : float
    + y : float
    + z : float
    + w : float
    + SerializableQuaternion(quaternion:Quaternion)
    + ToQuaternion() : Quaternion
}
@enduml
